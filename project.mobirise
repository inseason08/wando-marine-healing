                "padding": "0.5rem 1.8rem"
              },
              ".navbar-logo img": {
                "min-width": "6rem",
                "object-fit": "cover"
              },
              ".navbar-collapse": {
                "z-index": "1",
                "justify-content": "flex-end"
              },
